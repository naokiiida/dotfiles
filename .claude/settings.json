{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit(./**)",
      "Write(./**)",
      "MultiEdit(./**)",
      "mcp__github__search_repositories",
      "mcp__context7__resolve-library-id",
      "Skill",
      "WebFetch",
      "WebSearch",
      "Glob",
      "Grep",
      "LS",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(diff:*)",
      "Bash(parallel:*)",
      "Bash(uvx:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(pwd:*)",
      "Bash(pnpx:*)",
      "Bash(swift:*)",
      "Bash(go:*)",
      "Bash(golangci-lint run:*)",
      "Bash(cargo:*)",
      "Bash(make:*)",
      "Bash(node:*)",
      "Bash(which:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(tree:*)",
      "Bash(docker ps:*)",
      "Bash(docker network ls:*)",
      "Bash(docker image:*)",
      "Bash(log show:*)",
      "Bash(jq:*)",
      "Bash(xcodebuild:*)",
      "Bash(echo:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(pnpm:*)",
      "Bash(uv run:*)",
      "Bash(mmdc:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)"
    ],
    "deny": []
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e \"display notification \\\"$(jq -r .message)\\\" with title \\\"$(jq -r .title)\\\" sound name \\\"Glass\\\"\""
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e \"display notification \\\"$(jq -r .message)\\\" with title \\\"$(jq -r .title)\\\" sound name \\\"Glass\\\"\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/naokiiida/.config/claude-code/hooks/lint-on-file-change.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/naokiiida/.config/claude-code/hooks/bash-command-validatior.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/usr/local/bin/mini-ccstatus",
    "padding": 0
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "hookify@claude-plugins-official": false,
    "gitgud@gitgud-marketplace": false,
    "auto-memory@severity1-marketplace": false,
    "ralph-wiggum@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllow": true
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754070234392
  }
}
