      "Read",
      "Edit(./**)",
      "Write(./**)",
      "MultiEdit(./**)",
      "mcp__github__search_repositories",
      "mcp__context7__resolve-library-id",
      "Skill",
      "WebFetch",
      "WebSearch",
      "Glob",
      "Grep",
      "LS",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(diff:*)",
      "Bash(parallel:*)",
      "Bash(uvx:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(pwd:*)",
      "Bash(pnpx:*)",
      "Bash(go:*)",
      "Bash(golangci-lint run:*)",
      "Bash(cargo:*)",
      "Bash(make:*)",
      "Bash(node:*)",
      "Bash(which:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(tree:*)",
      "Bash(docker ps:*)",
      "Bash(docker network ls:*)",
      "Bash(docker image:*)",
      "Bash(journalctl:*)",
      "Bash(systemctl:*)",
      "Bash(jq:*)",
      "Bash(echo:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(pnpm:*)",
      "Bash(uv run:*)",
      "Bash(mmdc:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)"
