{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit(./**)",
      "Write(./**)",
      "MultiEdit(./**)",
      "mcp__github__search_repositories",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__claude_ai_Context7__query-docs",
      "mcp__claude_ai_Context7__resolve-library-id",
      "mcp__claude_ai_Grep_app__searchGitHub",
      "Skill",
      "WebFetch",
      "WebSearch",
      "Glob",
      "Grep",
      "LS",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(dig:*)",
      "Bash(scutil:*)",
      "Bash(parallel:*)",
      "Bash(uvx:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "Bash(touch:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(pwd:*)",
      "Bash(pnpx:*)",
      "Bash(swift:*)",
      "Bash(go:*)",
      "Bash(golangci-lint run:*)",
      "Bash(cargo:*)",
      "Bash(make:*)",
      "Bash(node:*)",
      "Bash(which:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(tree:*)",
      "Bash(docker ps:*)",
      "Bash(docker network ls:*)",
      "Bash(docker image:*)",
      "Bash(log show:*)",
      "Bash(jq:*)",
      "Bash(xcodebuild:*)",
      "Bash(echo:*)",
      "Bash(git:*)",
      "Bash(pnpm:*)",
      "Bash(uv run:*)",
      "Bash(mmdc:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh api:*)",
      "Bash(defuddle parse:*)",
      "Bash(DiscordChatExporter.Cli channels:*)",
      "Bash(DiscordChatExporter.Cli export:*)",
      "Bash(DiscordChatExporter.Cli guilds:*)",
      "mcp__pencil"
    ],
    "deny": []
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e \"display notification \\\"$(jq -r .message)\\\" with title \\\"$(jq -r .title)\\\" sound name \\\"Glass\\\"\""
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e \"display notification \\\"$(jq -r .message)\\\" with title \\\"$(jq -r .title)\\\" sound name \\\"Glass\\\"\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/naokiiida/.config/claude-code/hooks/lint-on-file-change.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/naokiiida/.config/claude-code/hooks/bash-command-validatior.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/cc_pure"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": true,
    "hookify@claude-plugins-official": false,
    "gitgud@gitgud-marketplace": false,
    "auto-memory@severity1-marketplace": false,
    "pyright-lsp@claude-plugins-official": true,
    "api-testing-observability@claude-code-workflows": false,
    "code-review@claude-plugins-official": true,
    "coding-tutor@every-marketplace": false,
    "code-refactoring@claude-code-workflows": true,
    "codebase-cleanup@claude-code-workflows": true,
    "tdd-workflows@claude-code-workflows": true,
    "code-simplifier@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "backend-api-security@claude-code-workflows": true,
    "notion-workspace-plugin@notion-plugin-marketplace": true,
    "slack@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
    "json-lsp@local-marketplace": true,
    "superpowers@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    }
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "localhost",
        "127.0.0.1",
        "[::1]",
        "host.docker.internal",
        "*.anthropic.com",
        "*.cloudflare.com",
        "*.context7.com",
        "*.crates.io",
        "*.docker.io",
        "*.github.com",
        "*.githubusercontent.com",
        "*.taiida.com",
        "api.search.brave.com",
        "files.pythonhosted.org",
        "index.crates.io",
        "jsoncanvas.org",
        "mcp.notion.com",
        "mcp.slack.com",
        "mcp.slack.com",
        "models.dev",
        "pypi.org",
        "registry.npmjs.org",
        "registry.yarnpkg.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches/uv",
        "~/.pnpm-store",
        "~/.config/pnpm",
        "~/.cargo",
        "~/Library/Caches/go-build",
        "~/go",
        "~/Library/Developer/Xcode/DerivedData",
        "~/Library/Caches/org.swift.swiftpm",
        "~/.config/gh"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.gnupg",
        "/etc"
      ]
    },
    "enableWeakerNetworkIsolation": true
  },
  "voiceEnabled": true,
  "teammateMode": "auto",
  "feedbackSurveyState": {
    "lastShownTime": 1754070234392
  }
}
