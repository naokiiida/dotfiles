# Save all videos here
-P "/Users/naokiiida/Movies/yt-dlp"
-o "%(playlist)s/%(title)s/%(title)s [%(id)s].%(ext)s"

# 1080p Premium Enhanced Bitrate
--extractor-args "youtube:player_client=default,ios"

# Download and merge the best video-only format and the best audio-only format,
# or download the best combined format if video-only format is not available
-f bv+ba/b

# # Restrict filenames to only ASCII characters, and avoid "&" and spaces in filenames
# --restrict-filenames

# Write thumbnail
--write-thumbnail

# Convert thumbnails to other format jpg png webp
--convert-thumbnails jpg

# Sponsorblock
--sponsorblock-mark default

# Download all the available subtitles
--write-subs
--sub-langs all,-live_chat
--no-write-auto-subs

# Convert Subs to ass (preserves NHK ARIB B24 styles: position, speaker colors)
# MP4 embedded subs lose ASS styles (converted to mov_text); external .ass files retain them
# For full embedded style support, use --remux-video mkv instead of mp4
--convert-subs ass

# Remux the video into another container
--remux-video mp4

# merge subtitles into video file
--embed-subs

# Embed metadata to the video file. Also adds chapters to file
--embed-metadata

# Do not overwrite existing output files
--no-overwrites

# Number of fragments of a dash/hlsnative video that should be download concurrently (default is 1)
--concurrent-fragments 4

# Append video to playlist
--exec "echo \"%(filepath)s\" >> /Users/naokiiida/Movies/yt-dlp/watchlist.m3u8"

# Create a .m3u8 playlist file, appending new videos to maintain play order and user edits
--exec 'if [ "%(playlist)s" != "NA" ]; then M3U_FILE="/Users/naokiiida/Movies/yt-dlp/%(playlist)s/%(playlist)s.m3u8"; if ! [ -f "$M3U_FILE" ]; then echo "#EXTM3U" > "$M3U_FILE"; fi; grep -qF -- "%(filepath)s" "$M3U_FILE" || echo "%(filepath)s" >> "$M3U_FILE"; fi'

