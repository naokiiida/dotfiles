	# signingkey = ~/.ssh/github.pub #this key only for signing, has no Auth permission, has passphrase
	# signingkey = ~/.ssh/id_ed25519.pub #this key is used for Auth only
[core]
	autocrlf = input
	safecrlf = warn
	editor = hx
	quotepath = off
    pager = delta
[alias]
	sw = switch
	ci = commit
	st = status
	br = branch
	li = log --oneline
	rf = log --simplify-by-decoration --oneline
	hist = log --pretty=format:'%Cblue%h %ad%Creset %s%C(auto)%d [%an]' --graph --date=short
	h = hist
	ha = hist --all
	type = cat-file -t
	dump = cat-file -p
	dt = difftool
	difft = difftool
	dlog = "-c diff.external=difft log -p --ext-diff"
    ipatch = "!f() { git apply $1 && git add -p --filter=difft; }; f"
	ds = -c delta.features=side-by-side diff
	dl = -c delta.line-numbers=true diff
	wta = git worktree add
	wtl = git worktree list
	wtr = git worktree remove
[init]
	defaultBranch = main
[merge]
	tool = vimdiff
	# guitool = gvimdiff
    conflictstyle = zdiff3 #follow delta recommendation
[mergetool "vimdiff"]
	hideResolved = true
	layout = "LOCAL, REMOTE + MERGED + LOCAL, MERGED, REMOTE"
# [mergetool "vimdiff1"]
# 	hideResolved = true
[diff]
# 	tool = vimdiff
# 	guitool = gvimdiff
    tool = difftastic
    colorMoved = default
[difftool]
        prompt = false
[difftool "difftastic"]
        cmd = difft "$LOCAL" "$REMOTE"
# [pager]
#         difftool = true
[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections

    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true
    hyperlinks = true
    hyperlinks-file-link-format = "zed://file/{path}:{line}"
    # hyperlinks-file-link-format = "vscode://file/{path}:{line}"
    # hyperlinks-file-link-format = "idea://open?file={path}&line={line}"
    # hyperlinks-file-link-format = "pycharm://open?file={path}&line={line}"
[gitbutler]
	aiModelProvider = openai
[gpg]
	format = ssh
[commit]
	gpgsign = true
[advice]
    addEmptyPathspec = false
    pushNonFastForward = false
    statusHints = false
[status]
    branch = true
    short = true
    showStash = true
    showUntrackedFiles = all  # show individual untracked files
[push]
    autoSetupRemote = true  # easier to push new branches
    default = current  # push only current branch by default
    followTags = true  # push also tags
	recurseSubmodules = on-demand
[submodule]
	recurse = true
